{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-only",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "msys2-debug",
      "displayName": "MSYS2 UCRT64 Debug",
      "inherits": ["base", "windows-only"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "msys2-release",
      "displayName": "MSYS2 UCRT64 Release",
      "inherits": ["base", "windows-only"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": ["base", "linux-only"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": ["base", "linux-only"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "msys2-debug", "configurePreset": "msys2-debug" },
    { "name": "msys2-release", "configurePreset": "msys2-release" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "timeout": 300
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    { "name": "msys2-debug", "inherits": "base", "configurePreset": "msys2-debug" },
    { "name": "msys2-release", "inherits": "base", "configurePreset": "msys2-release" },
    { "name": "linux-debug", "inherits": "base", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "base", "configurePreset": "linux-release" }
  ]
}
