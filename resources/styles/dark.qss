/* Sectoryn dark theme.
   Background #15171a, panels #1d2024, borders #2c3036, text #d7dbe0, muted #8a94a6,
   accent green #35c27a, secondary cyan #4cc2d6. Severity colors are set in code. */

QWidget {
    background-color: #15171a;
    color: #d7dbe0;
    font-size: 10pt;
    selection-background-color: #24533d;
    selection-color: #ffffff;
}

QMainWindow::separator,
QSplitter::handle {
    background-color: #2c3036;
}

QMenuBar,
QMenu,
QStatusBar,
QToolBar {
    background-color: #1d2024;
    border: none;
}

QMenuBar::item:selected,
QMenu::item:selected {
    background-color: #2c3036;
}

QMenu {
    border: 1px solid #2c3036;
}

QMenu::item:disabled {
    color: #5c6370;
}

QTabWidget::pane {
    border: 1px solid #2c3036;
    top: -1px;
}

QTabBar::tab {
    background-color: #1d2024;
    color: #8a94a6;
    padding: 6px 14px;
    border: 1px solid #2c3036;
    border-bottom: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #15171a;
    color: #d7dbe0;
    border-top: 2px solid #35c27a;
}

QTabBar::tab:disabled {
    color: #4b515b;
}

QTableView,
QTreeView,
QListView,
QPlainTextEdit,
QTextEdit {
    background-color: #1a1c20;
    alternate-background-color: #1e2125;
    border: 1px solid #2c3036;
    gridline-color: #2c3036;
}

QHeaderView::section {
    background-color: #1d2024;
    color: #aeb5c0;
    padding: 4px 6px;
    border: none;
    border-right: 1px solid #2c3036;
    border-bottom: 1px solid #2c3036;
}

QLineEdit,
QComboBox,
QSpinBox {
    background-color: #1a1c20;
    border: 1px solid #2c3036;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QTableView:focus,
QTreeView:focus,
QListView:focus {
    border: 1px solid #4cc2d6;
}

QPushButton {
    background-color: #24282e;
    border: 1px solid #353a42;
    border-radius: 3px;
    padding: 5px 14px;
}

QPushButton:hover {
    background-color: #2c3138;
}

QPushButton:focus {
    border: 1px solid #4cc2d6;
}

QPushButton:disabled {
    color: #5c6370;
}

QPushButton#primaryButton {
    background-color: #24533d;
    border-color: #35c27a;
    color: #ffffff;
}

QProgressBar {
    background-color: #1a1c20;
    border: 1px solid #2c3036;
    border-radius: 3px;
    max-height: 12px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #35c27a;
}

QGroupBox {
    border: 1px solid #2c3036;
    border-radius: 4px;
    margin-top: 14px;
    padding-top: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: #aeb5c0;
}

QLabel#panelMessage,
QLabel#mutedText {
    color: #8a94a6;
}

QLabel#errorText {
    color: #f26d4f;
}

QLabel#sectionHeading {
    color: #aeb5c0;
    font-weight: bold;
}

QFrame#dropZone {
    border: 2px dashed #353a42;
    border-radius: 8px;
    background-color: #181a1e;
}

QFrame#dropZone[dragActive="true"] {
    border-color: #35c27a;
    background-color: #1a2620;
}

QLabel#outcomeBadge {
    border-radius: 4px;
    padding: 4px 10px;
    font-weight: bold;
}

QToolTip {
    background-color: #24282e;
    color: #d7dbe0;
    border: 1px solid #353a42;
}

QScrollBar:vertical,
QScrollBar:horizontal {
    background-color: #15171a;
    border: none;
    margin: 0;
}

QScrollBar:vertical {
    width: 12px;
}

QScrollBar:horizontal {
    height: 12px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #353a42;
    border-radius: 4px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    min-height: 24px;
}

QScrollBar::handle:horizontal {
    min-width: 24px;
}

QScrollBar::handle:hover {
    background-color: #4b515b;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    width: 0;
    height: 0;
    background: none;
}
